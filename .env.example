# Simulated dataset directory (default: ./data/sim)
# CWYD_DATA_DIR=./data/sim
# CWYD_DATA_SEED=42
# Semantic catalog directory (default: ./semantic)
# CWYD_SEMANTIC_DIR=./semantic
# LangGraph orchestrator (Python). Vite proxies /api/inquiries when reachable.
# CWYD_ORCHESTRATOR_URL=http://127.0.0.1:8765
# Set to "off" to use local keyword prototype only.

# Orchestrator LLM: copy services/.env.example → services/.env (Azure AI Foundry recommended).
# AZURE_AI_ENDPOINT=https://<project>.inference.ai.azure.com
# AZURE_AI_API_KEY=
# AZURE_AI_DEPLOYMENT_NAME=gpt-4o-mini
