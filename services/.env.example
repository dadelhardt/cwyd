# Copy to services/.env and fill in values. Do not commit services/.env.

# Repository root (optional; auto-detected when running from cwyd)
# CWYD_ROOT=C:\path\to\cwyd
# CWYD_DATA_DIR=./data/sim
# CWYD_SEMANTIC_DIR=./semantic

# --- Azure AI Foundry (recommended) ---
# From Azure AI Foundry portal: Project → Endpoints and keys.
# Inference endpoint, for example:
#   https://<your-project>.inference.ai.azure.com
# or Azure OpenAI resource endpoint:
#   https://<resource-name>.openai.azure.com
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
# Model deployment name in your Foundry / Azure OpenAI project
AZURE_AI_DEPLOYMENT_NAME=gpt-4o-mini
# Chat completions API version
AZURE_AI_API_VERSION=2024-12-01-preview
# Force OpenAI v1 path: {AZURE_AI_ENDPOINT}/openai/v1 (typical for *.inference.ai.azure.com)
# AZURE_AI_USE_OPENAI_V1=true

# Aliases (optional; used when AZURE_AI_* is not set)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT_NAME=
# AZURE_OPENAI_API_VERSION=

# --- OpenAI-compatible fallback (public OpenAI or custom gateway) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
